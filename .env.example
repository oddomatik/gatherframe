# Generate a private .env with: node scripts/init-env.mjs
# Never commit a real .env or change APP_SECRET during an upgrade.
APP_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
ORIGIN=http://localhost:3000
SETUP_ENABLED=0
BIND_ADDRESS=127.0.0.1
PORT=3000
DATA_DIR=./data
GATHERFRAME_IMAGE=gatherframe:local
DOMAIN=photos.example.com
TZ=UTC
GOTIFY_ALLOW_PRIVATE=0
BODY_SIZE_LIMIT=Infinity
MAX_UPLOAD_BYTES=4294967296
STORAGE_MIN_FREE_BYTES=268435456
STORAGE_MATERIALIZE_CONCURRENCY=2
ZIP_CACHE_MAX_BYTES=21474836480
# Optional private B2 bucket; configure, test, then select it in Admin > Storage.
# This changes new writes, not existing files. See docs/b2-storage.md.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PREFIX=picture-day
